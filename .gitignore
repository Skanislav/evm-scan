# Build output
/bin/
*.test

# Generated by evmscan-demo: contains a dev-chain private key.
# Never commit a config with a publisher key in it.
config.demo.yaml
# Its token list, written beside it. No key in this one, but it names contracts on a
# chain that stops existing when the dev node does.
config.demo.tokens.json
config.local.yaml
*.local.yaml

# docs/RAILWAY.md has you put HELIOS_EXECUTION_RPC (an RPC key) and
# EVMSCAN_PUBLISHER_KEY in one of these. Same rule as above.
.env
.env.*

# Local dev chain data. The Makefile and docs/DEMO.md both use .devchain; /devchain/
# matched a path nothing has ever written.
/.devchain/
/devchain/
/data/

# Node tooling for the Solidity compiler
node_modules/
scripts/node_modules/
scripts/package-lock.json

# Editors / OS
.DS_Store
.idea/
.vscode/

# Claude Code agent worktrees
.claude/worktrees/
